if [[ ! -d arm-gnu-toolchain-15.2.rel1-aarch64-arm-none-eabi ]]; then
  curl -LO https://developer.arm.com/-/media/Files/downloads/gnu/15.2.rel1/binrel/arm-gnu-toolchain-15.2.rel1-aarch64-arm-none-eabi.tar.xz
  tar xf arm-gnu-toolchain-15.2.rel1-aarch64-arm-none-eabi.tar.xz
fi
export PATH=$PWD/arm-gnu-toolchain-15.2.rel1-aarch64-arm-none-eabi/bin:$PATH
export PATH=$HOME/.cargo/bin:$PATH
